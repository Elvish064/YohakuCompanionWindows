# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Local virtual environments and Conda environments
.venv/
venv/
env/
ENV/
.conda/

# Python packaging and editable-install metadata
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
wheels/

# PyInstaller build products
/build/
/dist/
*.exe
*.dll
*.pyd
*.manifest

# Test, coverage and static-analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Runtime state, diagnostics and crash dumps
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db-shm
*.db-wal
*.log
*.dmp
*.stackdump

# Local secrets and environment overrides
.env
.env.*
!.env.example

# IDE and editor state
.idea/
.vscode/
.vs/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*~
*.swp

# Windows and macOS filesystem metadata
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
